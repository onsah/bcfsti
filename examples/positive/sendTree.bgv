let
    sendTree : [mu x. +{ leaf: Skip, node: !Int; x; x }] -[m u 1]-> Unit
    sendTree c =
        if true then
            let x = select leaf (c : +{ leaf: Skip, node: !Int; (mu x. +{ leaf: Skip, node: !Int; x; x }); (mu x. +{ leaf: Skip, node: !Int; x; x }) }) in
            unit
        else
            let c1 = select node (c : +{ leaf: Skip, node: !Int; (mu x. +{ leaf: Skip, node: !Int; x; x }); (mu x. +{ leaf: Skip, node: !Int; x; x }) }) in
            let c2, c3 = lsplit !Int c1 in
            send @Int 42 c2;
            let c4, c5 = lsplit (mu x. +{ leaf: Skip, node: !Int; x; x }) c3 in
            sendTree c4;
            sendTree c5
in
unit
