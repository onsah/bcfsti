let x = 5 in x;
let f = (\x. x) in
f 3;
f 2;
(\x. x) 5;
let (x, y) = (c1, c2) in
x;
(case inj foo x {
    foo x -> { x + y }
    bar x -> { x - y }
});
let
    foo : Int -[m u 0]-> Int
    foo x = x + 5
in
foo 10;
let
    server : ?Int; !Int; Wait -[m u 1]→ Unit
    server c =
        let x = recv @Int c in
        send @Int (0 - x) c;
        wait c
in
    server c
